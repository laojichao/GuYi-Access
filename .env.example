# 复制为 .env（docker compose 会自动读取），并按注释填写
# 生成强随机值：openssl rand -hex 32

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=guyi_access
MYSQL_USER=guyi
MYSQL_PASSWORD=change-me-db-password

# --- 后端必填 ---
# JWT 签名密钥：必须 >= 32 字节（256 位），否则后端拒绝启动
JWT_SECRET=change-me-openssl-rand-hex-32
# 客户端管理动作（generate/ban/unban/del_card/kick）的对接令牌，勿使用示例值
API_TOKEN=change-me-api-token

# --- 后端可选 ---
# 设置后，安装接口必须携带 install_token 才能创建管理员（公网部署强烈建议设置）
INSTALL_TOKEN=
# 允许的前端来源，逗号分隔（如 https://a.example.com,https://b.example.com）
CORS_ORIGINS=http://localhost
# 进程默认时区：卡密到期用 JVM 时间、设备清理/看板用数据库时间，两者必须同区，
# 否则会出现「一张卡在一个查询里有效、在另一个查询里已过期」。需与 MySQL 时区保持一致。
APP_TIMEZONE=Asia/Shanghai
# 部署在 Nginx 等反向代理之后时设为 true（限流与拉黑按 X-Forwarded-For 末段取真实 IP）
TRUST_PROXY=true

# --- 端口映射 ---
BACKEND_PORT=8080
FRONTEND_PORT=80
